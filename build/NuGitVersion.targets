<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<PropertyGroup Condition="'$(GenerateAssemblyInfo)' == ''">
		<GenerateAssemblyInfo>true</GenerateAssemblyInfo>
		<GenerateAssemblyVersionAttribute>false</GenerateAssemblyVersionAttribute>
		<GenerateAssemblyFileVersionAttribute>false</GenerateAssemblyFileVersionAttribute>
		<GenerateAssemblyInformationalVersionAttribute>false</GenerateAssemblyInformationalVersionAttribute>
	</PropertyGroup>

	<PropertyGroup>
		<!-- Path of the version file, computed once and used everywhere below.
		     NormalizePath produces the directory separator of the current platform. A hand-built
		     "$(MSBuildProjectDirectory)\nugitversion.json" keeps its backslash inside the Exec
		     command on Linux/macOS and the tool would not find the file.
		     Can be overridden in the project file. -->
		<NuGitVersionFile Condition="'$(NuGitVersionFile)' == ''">$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', 'nugitversion.json'))</NuGitVersionFile>
	</PropertyGroup>

	<ItemGroup>
		<!-- Include nugitversion.json as AdditionalFile -->
		<AdditionalFiles Include="$(NuGitVersionFile)" />
	</ItemGroup>

	<Target Name="GenerateVersionInfo" BeforeTargets="BeforeCompile">
		<PropertyGroup>
			<NuGitToolDll>$(MSBuildThisFileDirectory)..\tools\NuGitVersion.Tool.dll</NuGitToolDll>
			<!-- Strip the trailing backslash, otherwise it escapes the closing quote on Windows -->
			<NuGitIntermediateDir>$(IntermediateOutputPath.TrimEnd('\').TrimEnd('/'))</NuGitIntermediateDir>
			<!-- Missing version file: the tool creates a default 0.1.0 on local builds and fails on
			     CI builds. NuGitVersionFailIfMissing=true|false overrides that decision. -->
			<NuGitToolExtraArgs Condition="'$(NuGitVersionFailIfMissing)' != ''">--fail-if-missing=$(NuGitVersionFailIfMissing)</NuGitToolExtraArgs>
			<NuGitToolCommand>dotnet "$(NuGitToolDll)" "$(NuGitIntermediateDir)" "$(NuGitVersionFile)" $(NuGitToolExtraArgs)</NuGitToolCommand>
		</PropertyGroup>

		<Error Text="NuGitVersion.Tool.dll not found: $(NuGitToolDll)"
			   Condition="!Exists('$(NuGitToolDll)')" />

		<Message Text="Generating version info..." Importance="high" />
		<Message Text="Executing: $(NuGitToolCommand)" Importance="high" />

		<Exec Command="$(NuGitToolCommand)"
			  WorkingDirectory="$(MSBuildProjectDirectory)"
			  ConsoleToMSBuild="true">
			<Output TaskParameter="ExitCode" PropertyName="NuGitToolExitCode" />
		</Exec>

		<ItemGroup>
			<Compile Include="$(IntermediateOutputPath)NuGitAssemblyInfo.g.cs" />
			<FileWrites Include="$(IntermediateOutputPath)NuGitAssemblyInfo.g.cs" />
		</ItemGroup>

		<Error Text="Version info generation failed with code $(NuGitToolExitCode)"
			   Condition="'$(NuGitToolExitCode)' != '0'" />
	</Target>
</Project>
